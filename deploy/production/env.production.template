# IPMCS Utility v1.0.0 — PRODUCTION settings (office apps server, next to ePULSE)
# This file becomes  backend\.env  (apply_update.bat copies it there on the first install).
# Fill every <...>. Never commit backend\.env.

PORT=8090

# ── This server's PostgreSQL: the IPMCS database (step1_setup_database.bat creates it) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=IPMCS_UTILITY_1.0
DB_USER=postgres
DB_PASSWORD=<postgres password of this server>

# ePULSE's database on the same server, read-only: login, jobs/units (ePULSE's live link to the
# PIMS server), the line list, P&IDs. Uses the DB_* login above.
EPULSE_DB_NAME=ePULSE_v1.0.0

# ePULSE's uploads folder — P&ID drawings are read from here when a folder is frozen
EPULSE_UPLOADS_ROOT=E:\ePULSE_v1.0.0\backend\uploads

# Login tokens — left empty, step 1 writes a new random value here
JWT_SECRET=

# Single sign-on — EXACTLY the SSO_SECRET of E:\ePULSE_v1.0.0\backend\.env
SSO_SECRET=<same as ePULSE>
