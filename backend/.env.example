# Copy this file to .env and fill in real values. .env is gitignored.

PORT=8090

DB_HOST=localhost
DB_PORT=5432
DB_NAME=IPMCS_UTILITY_1.0
DB_USER=postgres
DB_PASSWORD=

# Any long random string — used to sign login tokens.
JWT_SECRET=

# ePULSE database on the same Postgres server, read-only. IPMCS reads from it:
# login + jobs/units (ePULSE's live links to PC-2), the line list, P&IDs.
EPULSE_DB_NAME=ePULSE_DEV_v1.0.0

# ePULSE uploads folder — P&ID drawings (pid_documents.file_path is relative to it)
EPULSE_UPLOADS_ROOT=

# Single sign-on with ePULSE / MRCS / SSMS — must equal SSO_SECRET in their .env
SSO_SECRET=
