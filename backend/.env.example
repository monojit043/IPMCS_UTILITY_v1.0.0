# Copy this file to .env and fill in real values. .env is gitignored.

PORT=8090

DB_HOST=localhost
DB_PORT=5432
DB_NAME=IPMCS_UTILITY_1.0
# Same Postgres server, two other databases IPMCS reads from for login:
# employee identity/credentials, and PIMS project/unit role assignments.
MASTER_EMPLOYEE_DB_NAME=MASTER_EMPLOYEE_DB
PIMS_DB_NAME=PIMS_SQL
DB_USER=postgres
DB_PASSWORD=

# Any long random string — used to sign login tokens.
JWT_SECRET=

# Root folder PIMS's uploaded P&ID files live under — pid_documents.file_path
# values (e.g. "B378/111/PID/...pdf") are relative to this.
PIMS_PID_FILES_ROOT=
